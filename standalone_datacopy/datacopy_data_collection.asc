#include <algorithm>
#include <cstdint>
#include <fstream>
#include <iostream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "tiling_datacopy.h"

// All paths consume the same logical B[c,r] = A[r,c], without UB element padding.
// No compute operator was specified: this benchmark isolates transfer + tile fences.
// phase 0: transpose directly into UB; phase 1: produce full transposed GM;
// phase 2: read contiguous tiles from the already transposed GM.
template <uint32_t phase>
__aicore__ inline void RunTiles(GM_ADDR input, GM_ADDR output, GM_ADDR tiling)
{
  AscendC::InitSocState();
  const auto *t = reinterpret_cast<const __gm__ DataCopyTiling *>(tiling);
  const uint32_t rows = t->rows, cols = t->cols, tile_cols = t->tile_cols;
  AscendC::TPipe pipe;
  AscendC::TBuf<AscendC::TPosition::VECIN> buffer;
  pipe.InitBuffer(buffer, t->ub_bytes);
  auto ub = buffer.Get<int32_t>();
  AscendC::GlobalTensor<int32_t> gm, out;
  gm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(input));
  out.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(output));
  gm.SetL2CacheHint(AscendC::CacheMode::CACHE_MODE_DISABLE);
  out.SetL2CacheHint(AscendC::CacheMode::CACHE_MODE_DISABLE);
  AscendC::DataCopyPadExtParams<int32_t> pad{false, 0, 0, 0};
  AscendC::DataCopyExtParams gather{};
  gather.blockCount = rows;
  gather.blockLen = sizeof(int32_t);
  gather.srcStride = (cols - 1) * sizeof(int32_t);
  for (uint32_t c0 = 0; c0 < cols; c0 += tile_cols) {
    const uint32_t count = (cols - c0 < tile_cols) ? cols - c0 : tile_cols;
    AscendC::DataCopyExtParams linear{};
    linear.blockCount = 1;
    linear.blockLen = count * rows * sizeof(int32_t);
    if constexpr (phase == 2) {
      AscendC::DataCopyPad<int32_t, AscendC::PaddingMode::Compact>(
          ub, gm[c0 * rows], linear, pad);
    } else {
      for (uint32_t c = 0; c < count; ++c) {
        AscendC::DataCopyPad<int32_t, AscendC::PaddingMode::Compact>(
            ub[c * rows], gm[c0 + c], gather, pad);
      }
    }
    // A tile must be fully resident before a hypothetical consumer runs.
    AscendC::PipeBarrier<PIPE_MTE2>();
    if (phase == 1 || t->store) {
      AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE3>(EVENT_ID0);
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE3>(EVENT_ID0);
      AscendC::DataCopyPad<int32_t, AscendC::PaddingMode::Normal>(out[c0 * rows], ub, linear);
      // Do not let next tile overwrite UB before MTE3 has finished reading it.
      AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
      AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
    }
  }
  AscendC::PipeBarrier<PIPE_ALL>();
}

extern "C" __global__ __vector__ void datacopy_small(GM_ADDR x, GM_ADDR y, GM_ADDR t)
{ RunTiles<0>(x, y, t); }
extern "C" __global__ __vector__ void datacopy_large(GM_ADDR x, GM_ADDR y, GM_ADDR t)
{ RunTiles<0>(x, y, t); }
extern "C" __global__ __vector__ void datacopy_pretranspose(GM_ADDR x, GM_ADDR b, GM_ADDR t)
{ RunTiles<1>(x, b, t); }
extern "C" __global__ __vector__ void datacopy_contiguous(GM_ADDR b, GM_ADDR y, GM_ADDR t)
{ RunTiles<2>(b, y, t); }

void Check(aclError e) {
  if (e != ACL_SUCCESS) throw std::runtime_error("ACL error " + std::to_string(e));
}
struct DeviceBuffer {
  void *data = nullptr;
  aclrtStream stream;
  DeviceBuffer(size_t bytes, aclrtStream active_stream) : stream(active_stream) {
    Check(aclrtMalloc(&data, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
  }
  ~DeviceBuffer() {
    // Also protect pending launches during exception unwinding.
    if (data) { aclrtSynchronizeStream(stream); aclrtFree(data); }
  }
  DeviceBuffer(const DeviceBuffer &) = delete;
  DeviceBuffer &operator=(const DeviceBuffer &) = delete;
};
uint32_t Number(const char *s) {
  std::string value(s);
  if (value.empty() || value.find_first_not_of("0123456789") != std::string::npos)
    throw std::runtime_error("Expected a nonnegative integer");
  auto n = std::stoull(value);
  if (n > UINT32_MAX) throw std::runtime_error("Integer overflow");
  return static_cast<uint32_t>(n);
}
int main(int argc, char **argv) {
  aclrtStream stream = nullptr;
  bool initialized = false, device_set = false;
  uint32_t device = 0;
  int result = 0;
  try {
    if (argc != 7 && argc != 8) throw std::runtime_error(
        "Usage: demo_datacopy small|large|pretranspose ROWS COLS TILE_KIB STORE(0|1) DEVICE_ID [VERIFICATION_FILE]");
    const std::string mode(argv[1]);
    if (mode != "small" && mode != "large" && mode != "pretranspose")
      throw std::runtime_error("Unknown mode");
    DataCopyTiling t{};
    t.rows = Number(argv[2]); t.cols = Number(argv[3]);
    const uint32_t tile_kib = Number(argv[4]);
    t.store = Number(argv[5]);
    if (argc == 8 && t.store != 1) throw std::runtime_error("VERIFICATION_FILE requires STORE=1");
    device = Number(argv[6]);
    // 256KiB hardware UB, reserve 16KiB for runtime / future consumer scratch.
    if (!t.rows || t.rows > 4095 || t.rows % 8 || !t.cols || t.cols > 65535 ||
        !tile_kib || tile_kib > 240 || t.store > 1 || device > 255)
      throw std::runtime_error("rows: 8..4088 multiple of 8; cols: 1..65535; "
                               "tile: 1..240 KiB; store: 0/1; device: 0..255");
    t.tile_cols = std::min(t.cols, tile_kib * 1024 / (t.rows * 4));
    if (!t.tile_cols) throw std::runtime_error("Tile budget must hold a complete transposed row");
    t.ub_bytes = t.tile_cols * t.rows * 4;
    const size_t bytes = size_t(t.rows) * t.cols * 4;
    if (bytes > 64 * 1024 * 1024) throw std::runtime_error("Experiment GM input limit: 64 MiB");
    std::vector<int32_t> input(bytes / 4), output(t.store ? bytes / 4 : 0);
    for (size_t i = 0; i < input.size(); ++i) input[i] = static_cast<int32_t>(i * 17 + 3);
    Check(aclInit(nullptr)); initialized = true;
    Check(aclrtSetDevice(device)); device_set = true;
    Check(aclrtCreateStream(&stream));
    {
      DeviceBuffer x(bytes, stream), y(bytes, stream);
      DeviceBuffer b(mode == "pretranspose" ? bytes : 32, stream), td(sizeof(t), stream);
      Check(aclrtMemcpy(x.data, bytes, input.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
      Check(aclrtMemcpy(td.data, sizeof(t), &t, sizeof(t), ACL_MEMCPY_HOST_TO_DEVICE));
      if (t.store) Check(aclrtMemset(y.data, bytes, 0xA5, bytes));
      // Host launch arguments are ordinary pointers. GM_ADDR carries the
      // device __gm__ address space and must not be reinterpret_cast here.
      auto gx = static_cast<uint8_t *>(x.data);
      auto gy = static_cast<uint8_t *>(y.data);
      auto gb = static_cast<uint8_t *>(b.data);
      auto gt = static_cast<uint8_t *>(td.data);
      if (mode == "small") datacopy_small<<<1, nullptr, stream>>>(gx, gy, gt);
      else if (mode == "large") datacopy_large<<<1, nullptr, stream>>>(gx, gy, gt);
      else {
        datacopy_pretranspose<<<1, nullptr, stream>>>(gx, gb, gt);
        // Same stream orders full pretranspose completion before B is read.
        datacopy_contiguous<<<1, nullptr, stream>>>(gb, gy, gt);
      }
      Check(aclrtSynchronizeStream(stream));
      if (t.store) {
        Check(aclrtMemcpy(output.data(), bytes, y.data, bytes, ACL_MEMCPY_DEVICE_TO_HOST));
        for (uint32_t c = 0; c < t.cols; ++c)
          for (uint32_t r = 0; r < t.rows; ++r)
            if (output[c * t.rows + r] != input[r * t.cols + c])
              throw std::runtime_error("Transpose verification failed at " + std::to_string(r) + "," + std::to_string(c));
      }
      std::cout << "mode=" << mode << " rows=" << t.rows << " cols=" << t.cols
                << " input_bytes=" << bytes << " tile_cols=" << t.tile_cols
                << " tile_count=" << (t.cols + t.tile_cols - 1) / t.tile_cols
                << " ub_bytes=" << t.ub_bytes
                << " verification=" << (t.store ? "PASS" : "not_requested") << '\n';
    }
    if (aclrtDestroyStream(stream) != ACL_SUCCESS) result = 1;
    stream = nullptr;
    if (aclrtResetDevice(device) != ACL_SUCCESS) result = 1;
    device_set = false;
  } catch (const std::exception &e) {
    std::cerr << e.what() << '\n'; result = 1;
    if (stream) { aclrtSynchronizeStream(stream); aclrtDestroyStream(stream); }
    if (device_set) aclrtResetDevice(device);
  }
  if (initialized && aclFinalize() != ACL_SUCCESS) result = 1;
  // msprof can redirect application stdout elsewhere. Emit a dedicated report
  // only after all element checks and runtime cleanup have succeeded.
  if (result == 0 && argc == 8) {
    std::ofstream report(argv[7]);
    report << "verification=PASS\n";
    report.close();
    if (!report) { std::cerr << "Cannot write verification report: " << argv[7] << '\n'; result = 1; }
  }
  return result;
}
